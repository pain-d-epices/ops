# =============================================================================
#  Copiez ce fichier en ".env" et renseignez les valeurs.
#  Le fichier .env ne doit JAMAIS être versionné dans git (déjà dans .gitignore).
#
#  Pour une installation personnelle, seules les sections « Général », « Base de
#  données », « Redis » et « Sécurité » comptent. Tout le reste est facultatif.
# =============================================================================

# --- Général ----------------------------------------------------------------
# true  : installation autohébergée — tout est ouvert, la facturation est inerte.
# false : exploitation en service en ligne — paliers payants et quotas appliqués.
MODE_AUTOHEBERGE=true
ENVIRONNEMENT=developpement          # developpement | production
# Adresse publique du frontend (autorisée à appeler l'API)
ORIGINES_AUTORISEES=http://localhost:5183

# --- Base de données --------------------------------------------------------
POSTGRES_UTILISATEUR=searcher
POSTGRES_MOT_DE_PASSE=change_moi_en_production
POSTGRES_BASE=searcher
POSTGRES_HOTE=127.0.0.1
POSTGRES_PORT=5442

# --- Redis (file de tâches + temps réel + rate limiting) --------------------
REDIS_URL=redis://127.0.0.1:6389/0

# --- Sécurité ---------------------------------------------------------------
# Génère une clé avec :  python -c "import secrets; print(secrets.token_urlsafe(64))"
CLE_SECRETE=change_moi_absolument_avant_la_mise_en_production
DUREE_JETON_ACCES_MINUTES=15
DUREE_JETON_RAFRAICHISSEMENT_JOURS=14

# --- Stripe (facturation) ----------------------------------------------------
# FACULTATIF : ne sert que si MODE_AUTOHEBERGE=false. Laissez vide autrement.
# Clé secrète du compte Stripe (Développeurs > Clés API). sk_test_... en
# développement, sk_live_... en production — jamais la même clé pour les deux.
STRIPE_CLE_SECRETE=
# Secret de signature du endpoint webhook (Développeurs > Webhooks > votre endpoint),
# utilisé pour vérifier que les appels sur /api/v1/stripe/webhook viennent bien de Stripe.
STRIPE_WEBHOOK_SECRET=
# Pages de retour après le paiement Stripe Checkout et le portail de facturation.
STRIPE_URL_RETOUR_SUCCES=http://localhost:5183/abonnement?paiement=succes
STRIPE_URL_RETOUR_ANNULATION=http://localhost:5183/abonnement?paiement=annule
STRIPE_URL_RETOUR_PORTAIL=http://localhost:5183/abonnement
# Correspondance entre les identifiants de prix Stripe et les codes de plan internes
# (repli si la colonne `plans.stripe_price_id` n'est pas renseignée en base).
# Format : id_prix_stripe:code_plan,id_prix_stripe:code_plan
STRIPE_PRIX=price_abc123:starter,price_def456:pro,price_ghi789:entreprise

# --- Clés API optionnelles des modules de site ------------------------------
# Sans jeton GitHub : 60 requêtes/heure. Avec : 5000/heure. Fortement recommandé.
GITHUB_TOKEN=
# Reddit : identifiants d'application "script" (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Last.fm : clé gratuite (https://www.last.fm/api/account/create)
LASTFM_API_KEY=
# Twitch : application gratuite (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Chemins ----------------------------------------------------------------
# Dossier de travail temporaire pour les sorties Maigret
DOSSIER_DONNEES=./donnees
